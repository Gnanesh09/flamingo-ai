# Flamingo AI environment variables
# Copy this file to .env and fill in your own values:   cp .env.example .env
# Never commit .env. It is listed in .gitignore.
# All payment credentials must be PayPal SANDBOX credentials. There is no live-money mode.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs the demo session cookie. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# MongoDB connection string (MongoDB Atlas free tier works).
# Example format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flamingo
MONGODB_URI=

# Groq API key for the open-weight models (GPT-OSS, Qwen, vision): https://console.groq.com/keys
# Without it, Flamingo still works with rules only, but it can't read free-form text or photos.
GROQ_API_KEY=

# PayPal REST app credentials from developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ImageKit stores customer evidence photos as private files: https://imagekit.io/dashboard/developer/api-keys
# Required for photo uploads.
IMAGEKIT_PRIVATE_KEY=
# Your URL endpoint, for example https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Deepgram speech-to-text and Aura-2 text-to-speech for voice calls: https://console.deepgram.com
# Without it, the call button is disabled and text chat still works.
DEEPGRAM_API_KEY=

# Elasticsearch hybrid policy search and Jina OCR. All three are needed to turn it on.
# Without them, policy search uses local text retrieval.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Inference endpoint ID used by the semantic_text field, for example .elser-2-elasticsearch
ELASTICSEARCH_INFERENCE_ID=

# Override the Groq models (defaults shown)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_WRITER_MODEL=qwen/qwen3.8-27b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Ports used by `pnpm run dev:local` (defaults shown)
# LOCAL_PORT=3000
# API_PORT=8080
# WEB_PORT=3001

# LOG_LEVEL=info
